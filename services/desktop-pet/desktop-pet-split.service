[Unit]
Description=desktop-pet frontend (piscreen client, animation pack; sockets mode)
# 只排順序、只用 Wants=：桌寵停止／重啟／失敗都不會連帶停止或重啟 piscreen、picam（絕對不要改成 Requires=/BindsTo=）
Wants=network-online.target piscreen.service picam.service
After=network-online.target piscreen.service picam.service
StartLimitIntervalSec=0

[Service]
Type=simple
# @USER@ / @HOME@ / @BACKEND_URL@ 是佔位，install.sh 依 deploy.env 換成實際值（見 deploy.env.example）
User=@USER@
Group=@USER@
WorkingDirectory=@HOME@/desktop-pet
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=desktop-pet
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# 切換至後台模式：關閉主程式內建 web 與 wifi，改由 Unix sockets (/run/desktop-pet) 提供給 desktop-pet-admin
ExecStart=/usr/bin/python3 @HOME@/desktop-pet/main.py --sink piscreen --input web --web off --wifi off --fps 20 --backend @BACKEND_URL@ --pack @HOME@/desktop-pet/packs/seed --backend-token-file @HOME@/.config/desktop-pet/backend-token
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
