[Unit]
Description=desktop-pet frontend (piscreen client, animation pack, web remote)
# 只排順序、只用 Wants=：桌寵停止／重啟／失敗都不會連帶停止或重啟 piscreen、picam（絕對不要改成 Requires=/BindsTo=）
Wants=network-online.target piscreen.service picam.service
After=network-online.target piscreen.service picam.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi-user
Group=pi-user
WorkingDirectory=/home/pi-user/desktop-pet
Environment=PYTHONUNBUFFERED=1
# 參數跟之前手動跑的一樣；後端 token 從檔案讀（0600），不放命令列
ExecStart=/usr/bin/python3 /home/pi-user/desktop-pet/main.py --sink piscreen --input web --web 0.0.0.0:8080 --fps 20 --backend https://pet.example.com --pack /home/pi-user/desktop-pet/packs/seed --backend-token-file /home/pi-user/.config/desktop-pet/backend-token
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
