{
  "comment": "狀態機設定：(目前狀態, 事件) → 下一個狀態。時間單位為秒。from 可用 \"*\" 代表任何狀態；具體狀態的規則優先於 \"*\"。",
  "initial": "idle",
  "states": {
    "idle": {
      "label": "待機",
      "animation": "idle",
      "eyes": "normal",
      "timers": [{"after": 600, "event": "idle_timeout", "reset_on_input": true}]
    },
    "happy": {
      "label": "開心",
      "animation": "happy",
      "eyes": "happy",
      "timers": [{"after": 3.0, "event": "happy_done", "reset_on_input": false}],
      "on_enter": [{"name": "motion", "params": {"motion": "nod", "times": 1}}]
    },
    "bored": {
      "label": "無聊",
      "animation": "bored",
      "eyes": "bored",
      "timers": [{"after": 600, "event": "idle_timeout", "reset_on_input": true}]
    },
    "sleep": {
      "label": "睡覺",
      "animation": "sleep",
      "eyes": "sleep",
      "effects": ["zzz"],
      "timers": []
    },
    "happy_1": {
      "label": "微笑",
      "animation": "happy_1",
      "eyes": "happy",
      "timers": [{"after": 4.7, "event": "happy_1_done", "reset_on_input": false}]
    },
    "happy_2": {
      "label": "開心",
      "animation": "happy_2",
      "eyes": "happy",
      "timers": [{"after": 3.5, "event": "happy_2_done", "reset_on_input": false}]
    },
    "happy_3": {
      "label": "超開心",
      "animation": "happy_3",
      "eyes": "happy",
      "timers": [{"after": 3.9, "event": "happy_3_done", "reset_on_input": false}]
    },
    "surprised_1": {
      "label": "愣一下",
      "animation": "surprised_1",
      "eyes": "surprised",
      "timers": [{"after": 2.3, "event": "surprised_1_done", "reset_on_input": false}]
    },
    "surprised_2": {
      "label": "往後縮",
      "animation": "surprised_2",
      "eyes": "surprised",
      "timers": [{"after": 2.3, "event": "surprised_2_done", "reset_on_input": false}]
    },
    "surprised_3": {
      "label": "嚇到彈起",
      "animation": "surprised_3",
      "eyes": "surprised",
      "timers": [{"after": 2.3, "event": "surprised_3_done", "reset_on_input": false}]
    },
    "sad_1": {
      "label": "垂眼",
      "animation": "sad_1",
      "eyes": "sad",
      "timers": [{"after": 6.3, "event": "sad_1_done", "reset_on_input": false}]
    },
    "sad_2": {
      "label": "低頭縮小",
      "animation": "sad_2",
      "eyes": "sad",
      "timers": [{"after": 6.3, "event": "sad_2_done", "reset_on_input": false}]
    },
    "sad_3": {
      "label": "哭哭",
      "animation": "sad_3",
      "eyes": "sad",
      "timers": [{"after": 4.7, "event": "sad_3_done", "reset_on_input": false}]
    },
    "shy": {
      "label": "害羞",
      "animation": "shy",
      "eyes": "squint",
      "timers": [{"after": 6.3, "event": "shy_done", "reset_on_input": false}]
    },
    "annoyed_1": {
      "label": "皺眉",
      "animation": "annoyed_1",
      "eyes": "squint",
      "timers": [{"after": 4.7, "event": "annoyed_1_done", "reset_on_input": false}]
    },
    "annoyed_2": {
      "label": "生氣",
      "animation": "annoyed_2",
      "eyes": "squint",
      "timers": [{"after": 4.7, "event": "annoyed_2_done", "reset_on_input": false}]
    }
  },
  "transitions": [
    {"from": "idle",  "event": "pat",          "to": "happy"},
    {"from": "idle",  "event": "poke",         "to": "happy"},
    {"from": "idle",  "event": "press",        "to": "happy"},
    {"from": "idle",  "event": "person_near",  "to": "happy"},
    {"from": "idle",  "event": "idle_timeout", "to": "bored"},
    {"from": "idle",  "event": "night",        "to": "sleep"},

    {"from": "happy", "event": "pat",          "to": "happy"},
    {"from": "happy", "event": "happy_done",   "to": "idle"},

    {"from": "bored", "event": "pat",          "to": "happy"},
    {"from": "bored", "event": "poke",         "to": "idle"},
    {"from": "bored", "event": "press",        "to": "idle"},
    {"from": "bored", "event": "person_near",  "to": "idle"},
    {"from": "bored", "event": "idle_timeout", "to": "sleep"},
    {"from": "bored", "event": "night",        "to": "sleep"},

    {"from": "sleep", "event": "pat",          "to": "idle"},
    {"from": "sleep", "event": "poke",         "to": "idle"},
    {"from": "sleep", "event": "press",        "to": "idle"},
    {"from": "sleep", "event": "morning",      "to": "idle"},

    {"from": "happy_1",     "event": "happy_1_done",     "to": "idle"},
    {"from": "happy_2",     "event": "happy_2_done",     "to": "idle"},
    {"from": "happy_3",     "event": "happy_3_done",     "to": "idle"},
    {"from": "surprised_1", "event": "surprised_1_done", "to": "idle"},
    {"from": "surprised_2", "event": "surprised_2_done", "to": "idle"},
    {"from": "surprised_3", "event": "surprised_3_done", "to": "idle"},
    {"from": "sad_1",       "event": "sad_1_done",       "to": "idle"},
    {"from": "sad_2",       "event": "sad_2_done",       "to": "idle"},
    {"from": "sad_3",       "event": "sad_3_done",       "to": "idle"},
    {"from": "shy",         "event": "shy_done",         "to": "idle"},
    {"from": "annoyed_1",   "event": "annoyed_1_done",   "to": "idle"},
    {"from": "annoyed_2",   "event": "annoyed_2_done",   "to": "idle"},

    {"from": "*",     "event": "wake",         "to": "idle"},
    {"from": "*",     "event": "sleep",        "to": "sleep"}
  ],
  "growth": {
    "comment": "成長階段 → 骨架檔。推進規則尚未決定（只有資料結構與 set_stage 接口）。",
    "stages": {
      "1": {"name": "種子", "skeleton": "assets/skeletons/seed.json"},
      "2": {"name": "長腳", "skeleton": "assets/skeletons/legs.json"},
      "3": {"name": "長耳朵", "skeleton": "assets/skeletons/ears.json"}
    }
  },
  "emotions": {
    "comment": "情緒強度狀態設定：各情緒最高等級、各狀態可進入的情緒（* 代表其餘狀態）、觸控輸入對應與時間窗。",
    "levels": {
      "happy": 3,
      "surprised": 3,
      "sad": 3,
      "shy": 1,
      "annoyed": 2
    },
    "accept": {
      "sleep": ["surprised"],
      "*": ["happy", "surprised", "sad", "shy", "annoyed"]
    },
    "inputs": {
      "pat": {
        "emotion": "happy",
        "window_s": 4.0
      },
      "poke": {
        "emotion": "surprised",
        "window_s": 5.0,
        "annoyed_after": 3,
        "annoyed_emotion": "annoyed"
      }
    }
  },
  "clock": {"night_start": 23, "night_end": 7, "enabled": true}
}
