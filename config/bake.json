    "annoyed_2": {
      "cut_every": 32,
      "variants": [
        {"name": "base", "weight": 2},
        {"name": "glare", "weight": 1, "looks": [[0.3, 0.0, -0.4], [1.2, 0.0, 0.0]]}
      ]
