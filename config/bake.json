    "surprised_2": {
      "cut_every": 48,
      "variants": [
        {"name": "base", "weight": 1},
        {"name": "blink", "weight": 2, "blinks": [1.7]},
        {"name": "look_r", "weight": 1, "looks": [[0.7, 0.7, -0.2], [1.6, 0.0, 0.0]]}
      ]
    },
    "surprised_3": {
      "cut_every": 48,
      "variants": [
        {"name": "base", "weight": 1},
