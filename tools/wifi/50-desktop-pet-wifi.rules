// desktop-pet：讓桌寵程式（使用者 pi-user，沒有登入工作階段的 systemd 服務）不用 sudo 就能管理 Wi‑Fi。
// 只開放這四個 NetworkManager 動作；其他（開關整個 Wi‑Fi、網路睡眠、改主機名稱…）照系統預設。
// 程式本身只對 Wi‑Fi 介面（wlan0）與 802-11-wireless 連線下指令，不碰有線網路。
// 安裝：sudo install -m 0644 tools/wifi/50-desktop-pet-wifi.rules /etc/polkit-1/rules.d/
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.share.protected"
    ];
    if (subject.user == "pi-user" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
