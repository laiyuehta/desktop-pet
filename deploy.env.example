# desktop-pet 部署設定範本。複製成 repo 根目錄的 deploy.env（已在 .gitignore，不會進 repo）再改成實際值：
#   cp deploy.env.example deploy.env
# install.sh 會把 service／polkit 檔裡的 @USER@ / @HOME@ / @BACKEND_URL@ 換成這裡的值；腳本只讀這個檔，不會改它。
# 不要在這裡放 token：token 放在 @HOME@/.config/desktop-pet/backend-token（0600）。
#
# 格式（v2.9 起 systemd EnvironmentFile、sh、Python 都會讀，三邊要一致）：
#   一行一個 KEY=VALUE，# 開頭是註解；不加引號、不寫 export、不用 $VAR 展開、= 兩邊不留空白。值留空 = 沒設。
#   只放「位置」不放機密本身：token 一律放檔案，這裡只寫 *_TOKEN_FILE 路徑。
#   下面的 @HOME@ 是佔位，實際的環境檔要寫成真正的路徑；R7 的環境檔可以寫 %LOCALAPPDATA%（Python 會展開）。

# 執行桌寵／picam 的使用者（留空 = 呼叫 sudo 的使用者或目前使用者）
PET_USER=
# 該使用者的家目錄（留空 = 從 /etc/passwd 查）
PET_HOME=
# 後端（大腦）網址
PET_BACKEND_URL=https://pet.example.com

# ---------------------------------------------------------------------------
# 以下是項目書 v2.9「16. 自動部署」的規格（尚未實作），先用註解列出，實作 PR 再打開。
# v2.9 起 Pi 的環境檔改放 /etc/desktop-pet/env（root:@USER@ 0640），repo 根目錄的 deploy.env 只在過渡期讀。
# 變數說明與優先順序見 PROPOSAL.md 16.2。
# ---------------------------------------------------------------------------

# --- Pi：桌寵主程式（執行時由 systemd 載入；命令列參數 > 這裡 > 內建預設）---
#PET_BACKEND_TOKEN_FILE=@HOME@/.config/desktop-pet/backend-token
#PET_PET_ID=seed-001
#PET_PACK_DIR=@HOME@/.local/share/desktop-pet/packs/seed
#PET_WEB_LISTEN=0.0.0.0:8080
#PET_CAMERA_PENDING_DIR=@HOME@/.local/share/desktop-pet/pending-photos
#PET_WIFI_IFACE=wlan0
#PET_HOTSPOT_URL=

# --- 兩台：自動更新 ---
# 0 = 暫停（現場除錯用）；也可以在 PET_STATE_DIR 建 PAUSE 檔
#PET_AUTOUPDATE=1
#PET_AUTOUPDATE_REPO=https://github.com/laiyuehta/desktop-pet
#PET_AUTOUPDATE_BRANCH=main
# 檢查間隔（秒，最小 300）
#PET_AUTOUPDATE_INTERVAL=600
# 1 = 新 commit 的 CI 兩個必過 check 都 success 才部署
#PET_AUTOUPDATE_REQUIRE_CI=1
# 填 commit 就固定在那一版
#PET_AUTOUPDATE_PIN=
#PET_AUTOUPDATE_KEEP=3
#PET_AUTOUPDATE_HEALTH_TIMEOUT=120
#PET_AUTOUPDATE_HEALTH_MIN_FPS=18
#PET_RELEASES_DIR=@HOME@/desktop-pet-releases
#PET_STATE_DIR=@HOME@/.local/state/desktop-pet/update

# --- R7：後端（環境檔 %LOCALAPPDATA%\desktop-pet\env，只由 Python 讀；命令列 > 環境變數 > config.json > config.example.json）---
#PET_PY=
#PET_PYTHONW=
#PET_BACKEND_HOST=0.0.0.0
#PET_BACKEND_PORT=8090
#PET_SUPERVISOR_LOCK_PORT=18090
#PET_BACKEND_CONFIG=%LOCALAPPDATA%\desktop-pet\config\config.json
#PET_BACKEND_DATA_DIR=%LOCALAPPDATA%\desktop-pet\data
#PET_BACKEND_LOG_DIR=%LOCALAPPDATA%\desktop-pet\logs
#PET_BACKEND_API_TOKEN_FILE=%LOCALAPPDATA%\desktop-pet\secrets\backend-token
#PET_LLM_LOCAL_URL=http://127.0.0.1:8080/v1
#PET_LLM_LOCAL_MODEL=qwen3-14b
#PET_CONSOLE_LISTEN=127.0.0.1:8091,192.0.2.10:8091
#PET_RELEASES_DIR=%LOCALAPPDATA%\desktop-pet\releases
#PET_STATE_DIR=%LOCALAPPDATA%\desktop-pet\state
