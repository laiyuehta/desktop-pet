# desktop-pet 部署設定範本。
# Pi 建議放到 /etc/desktop-pet/env（root:@USER@ 0640）；過渡期也相容 repo 根目錄的 deploy.env（不進 repo）。
# R7 建議放到 %LOCALAPPDATA%\desktop-pet\env。
# install.sh 會把 service／polkit 檔裡的 @USER@ / @HOME@ 換成這裡的值；腳本只讀這個檔，不會改它。
# 不要在這裡放 token：token 放在 @HOME@/.config/desktop-pet/backend-token（0600）或 %LOCALAPPDATA%\desktop-pet\secrets\backend-token。
#
# 格式（v2.9 起 systemd EnvironmentFile、sh、Python 都會讀，三邊要一致）：
#   一行一個 KEY=VALUE，# 開頭是註解；不加引號、不寫 export、不用 $VAR 展開、= 兩邊不留空白。值留空 = 沒設。
#   只放「位置」不放機密本身：token 一律放檔案，這裡只寫 *_TOKEN_FILE 路徑。
#   下面的 @HOME@ 是佔位，實際的環境檔要寫成真正的路徑；R7 的環境檔可以寫 %LOCALAPPDATA%（Python 會展開）。
#   變數說明與優先順序見 PROPOSAL.md 16.2。

# 執行桌寵／picam 的使用者（留空 = 呼叫 sudo 的使用者或目前使用者）
PET_USER=
# 該使用者的家目錄（留空 = 從 /etc/passwd 查）
PET_HOME=
# 後端（大腦）網址
PET_BACKEND_URL=https://pet.example.com

# --- Pi：桌寵主程式與前端後台（執行時由 systemd EnvironmentFile 或 Python 載入；命令列參數 > 環境變數 > 這裡 > 內建預設）---
PET_BACKEND_TOKEN_FILE=@HOME@/.config/desktop-pet/backend-token
# 1 = 允許非 HTTPS 且非私有 IP/localhost 時送出金鑰（測試用）
PET_ALLOW_INSECURE_LAN=
PET_PET_ID=seed-001
# 動畫包資料夾（留空 = auto：@HOME@/.local/share/desktop-pet/packs/<骨架>，在 repo 外；也可指定路徑例如 @HOME@/.local/share/desktop-pet/packs/seed）
PET_PACK_DIR=
PET_WEB_LISTEN=0.0.0.0:8080
PET_CAMERA_PENDING_DIR=@HOME@/.local/share/desktop-pet/pending-photos
PET_WIFI_IFACE=wlan0
PET_HOTSPOT_URL=

# --- Pi：依硬體選用的子服務（#38；1 = 有這個硬體，安裝／啟動腳本才會裝／開；留空或 0 = 略過）---
# picam：相機守護程式（frontend/services/picam/install.sh）
PET_ENABLE_PICAM=
# camcast：相機預覽投到螢幕（frontend/services/camcast/start.sh）
PET_ENABLE_CAMCAST=

# --- 兩台：自動更新（規格見 PROPOSAL.md 16）---
# 0 = 暫停（現場除錯用）；也可以在 PET_STATE_DIR 建 PAUSE 檔
#PET_AUTOUPDATE=1
#PET_AUTOUPDATE_REPO=https://github.com/laiyuehta/desktop-pet
#PET_AUTOUPDATE_BRANCH=main
# 檢查間隔（秒，最小 300）
#PET_AUTOUPDATE_INTERVAL=300
# 1 = 新 commit 的 CI 兩個必過 check 都 success 才部署
#PET_AUTOUPDATE_REQUIRE_CI=1
# 填 commit 就固定在那一版
#PET_AUTOUPDATE_PIN=
#PET_AUTOUPDATE_HEALTH_TIMEOUT=120
#PET_AUTOUPDATE_HEALTH_MIN_FPS=18
#PET_INSTALL_DIR=@HOME@/desktop-pet
#PET_BACKUP_DIR=@HOME@/.local/share/desktop-pet/backup
#PET_STATE_DIR=@HOME@/.local/state/desktop-pet/update

# --- R7：後端（環境檔 %LOCALAPPDATA%\desktop-pet\env，由 Python 與 start_hidden.cmd 讀；命令列 > 環境變數 > config.json > config.example.json）---
PET_PY=
PET_PYTHONW=
PET_BACKEND_HOST=0.0.0.0
PET_BACKEND_PORT=8090
PET_SUPERVISOR_LOCK_PORT=18090
PET_BACKEND_CONFIG=%LOCALAPPDATA%\desktop-pet\config\config.json
PET_BACKEND_DATA_DIR=%LOCALAPPDATA%\desktop-pet\data
PET_BACKEND_LOG_DIR=%LOCALAPPDATA%\desktop-pet\logs
PET_BACKEND_API_TOKEN_FILE=
# PET_BACKEND_KEYS_FILE：獨立金鑰雜湊清單檔（空 = 讀 config.json 的 server.keys）
PET_BACKEND_KEYS_FILE=
# PET_BACKEND_TRUSTED_PROXIES：信任的反向代理 IP（逗號分隔，預設 127.0.0.1,::1）
PET_BACKEND_TRUSTED_PROXIES=
PET_LLM_LOCAL_URL=http://127.0.0.1:8080/v1
PET_LLM_LOCAL_MODEL=qwen3-14b
# 控制台監聽位址（192.0.2.10 為示範用文件專用位址，實際使用請改為實際 IP 或改回註解）
#PET_CONSOLE_LISTEN=127.0.0.1:8091,192.0.2.10:8091
