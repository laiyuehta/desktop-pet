[Unit]
Description=desktop-pet-admin frontend management (web remote, screen mirror, wifi manager)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@HOME@/desktop-pet/frontend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/desktop-pet/env
RuntimeDirectory=desktop-pet
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
# python 用 frontend/.venv（install.sh 會建立；#38）
ExecStart=@HOME@/desktop-pet/frontend/.venv/bin/python @HOME@/desktop-pet/frontend/services/desktop-pet-admin/admin.py --control-socket /run/desktop-pet/control.sock --frames-socket /run/desktop-pet/frames.sock --wifi auto
Restart=always
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
